<Window x:Class="ReactionMixingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReactionMixingSystem"
        mc:Ignorable="d"
        Background="#FF1E1E1E"
        Title="Reaction Mixing System" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".25*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height=".25*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <local:CommonStatusControl x:Name="CommonStatus" Grid.Row="1" Grid.Column="1"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   InitializeRequested="Button_Click"/>
    </Grid>
</Window>
