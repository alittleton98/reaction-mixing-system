<UserControl x:Class="ReactionMixingSystem.CommonStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="300">
    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="4">
        <StackPanel>
            <TextBlock Text="Reaction Common" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" Text="Not initialized" Margin="0,0,0,8"/>
            <Button x:Name="InitializeButton" Content="Initialize" Click="InitializeButton_Click"/>
        </StackPanel>
    </Border>
</UserControl>
